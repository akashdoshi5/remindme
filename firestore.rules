rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // USERS COLLECTION
    // Strictly allow access only to the user themselves
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      
      // Subcollections (reminders, caregivers) inherit strict ownership (relaxed for reminders read)
      match /reminders/{reminderId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
      match /caregivers/{caregiverId} {
        allow read, write: if isOwner(userId);
      }
      match /deletedNotes/{noteId} {
        allow read, write: if isOwner(userId);
      }
    }

    // COLLECTION GROUP QUERY: CAREGIVERS
    // Allow a user to find all instances where THEY are listed as a caregiver
    match /{path=**}/caregivers/{caregiverId} {
      allow read: if isAuthenticated() && resource.data.email == request.auth.token.email;
    }

    // NOTES COLLECTION (Root Level for Sharing)
    match /notes/{noteId} {
      // Allow create: Any auth user can create a note (must set themselves as owner)
      allow create: if isAuthenticated() 
                   && request.resource.data.ownerId == request.auth.uid;

      // Allow read: If owner (by ownerId, userId, or ownerEmail) OR if in sharedWith list
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid || 
        resource.data.ownerEmail == request.auth.token.email ||
        request.auth.token.email in resource.data.sharedWith
      );

      // Allow update: Owner (by ownerId, userId, or ownerEmail) OR Shared users
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email ||
        (
          request.auth.token.email in resource.data.sharedWith &&
          // Ensure ownership is not stolen
          (request.resource.data.ownerId == resource.data.ownerId || request.resource.data.userId == resource.data.userId) &&
          request.resource.data.sharedWith == resource.data.sharedWith
        )
      );

      // Allow delete: Owner by various identifier fields (handles legacy and migration cases)
      // Check ownerId, userId, ownerEmail, or if user is in sharedWith
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.ownerEmail == request.auth.token.email ||
        request.auth.token.email in resource.data.sharedWith
      );
    }
  }
}
